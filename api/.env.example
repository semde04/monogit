NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/lostfound
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGIN=*
# Firebase Cloud Messaging push delivery
FIREBASE_PROJECT_ID=lost-found-74fa4
# Set this to the private service-account JSON file path in api/.env.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
# Set these locally only when running `npm run create-admin`.
# ADMIN_NAME=LostFound Admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-password-of-at-least-12-characters
